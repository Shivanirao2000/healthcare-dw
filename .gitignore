# ── dbt ───────────────────────────────────────────────────────────────────────
dbt_project/target/
dbt_project/dbt_packages/
dbt_project/logs/
# profiles.yml uses only env_var() — no hardcoded credentials — so it IS committed.
# The .example variant is kept for documentation only.

# ── Great Expectations ────────────────────────────────────────────────────────
# uncommitted/ holds runtime artifacts: validation results, data docs HTML, and
# config_variables.yml which may contain secrets. The .gitkeep preserves the
# directory structure; the contents are never committed.
great_expectations/uncommitted/**
!great_expectations/uncommitted/.gitkeep
great_expectations/.ge_store_backend_id

# ── Airflow ───────────────────────────────────────────────────────────────────
airflow/logs/**
!airflow/logs/.gitkeep
airflow/airflow.db
airflow.cfg
airflow.db
webserver_config.py
standalone_admin_password.txt

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── macOS ─────────────────────────────────────────────────────────────────────
