# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcare_dw
DB_USER=dw_user
DB_PASSWORD=changeme

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=healthcare-raw-data

# ── dbt ───────────────────────────────────────────────────────────────────────
DBT_PROFILES_DIR=./dbt_project
DBT_TARGET=dev

# ── Airflow ───────────────────────────────────────────────────────────────────
# Postgres metadata database (internal to the Docker stack — not Snowflake)
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=changeme_airflow_db
AIRFLOW_POSTGRES_DB=airflow

# Airflow web UI credentials
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme_airflow_ui
AIRFLOW_ADMIN_EMAIL=admin@example.com

AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=
# Match host user ID to avoid file-permission issues on mounted volumes
# Set with: echo "AIRFLOW_UID=$(id -u)" >> .env
AIRFLOW_UID=50000

# ── Great Expectations ────────────────────────────────────────────────────────
GE_ROOT_DIR=./great_expectations

# ── Snowflake ─────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=HEALTHCARE_WH
SNOWFLAKE_DATABASE=HEALTHCARE_DW

# ── Source systems ────────────────────────────────────────────────────────────
EHR_API_URL=
EHR_API_KEY=
CLAIMS_SFTP_HOST=
CLAIMS_SFTP_USER=
CLAIMS_SFTP_KEY_PATH=
